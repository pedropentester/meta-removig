<Window x:Class="MetaRemovig.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meta Removig" Height="660" Width="920" MinHeight="580" MinWidth="780"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop" DragEnter="Window_DragEnter"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="White">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0C16" Offset="0"/>
            <GradientStop Color="#151830" Offset="0.55"/>
            <GradientStop Color="#0B0C16" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C5CFF" Offset="0"/>
            <GradientStop Color="#19C3FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Botón grande principal -->
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="36" Padding="56,30"
                                Background="{StaticResource AccentBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect Color="#7C5CFF" BlurRadius="50" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Viewbox Width="34" Height="34" Margin="0,0,16,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="White"
                                              Data="M12,3 L6.5,8.5 L10.5,8.5 L10.5,15.5 L13.5,15.5 L13.5,8.5 L17.5,8.5 Z M4,17.5 L20,17.5 L20,21 L4,21 Z"/>
                                    </Canvas>
                                </Viewbox>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1.05" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1.05" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.14"/>
                                            <DoubleAnimation Storyboard.TargetName="Bd"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.14"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón secundario (contorno) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E6E8FF"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Padding="26,13"
                                BorderBrush="#3A3E66" BorderThickness="1.5" Background="#14172C">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1E2240"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#7C5CFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón de acción (relleno) -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="16" Padding="30,14"
                                Background="{StaticResource AccentBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barra de progreso fina -->
        <Style x:Key="SlimProgress" TargetType="ProgressBar">
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="5" Background="#22254A"/>
                            <Border x:Name="PART_Track"/>
                            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Resplandor decorativo -->
        <Ellipse Width="520" Height="520" Opacity="0.22" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#7C5CFF" Offset="0"/>
                    <GradientStop Color="Transparent" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- 1) INICIO -->
        <StackPanel x:Name="StartPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Meta Removig" FontSize="18" FontWeight="SemiBold" Foreground="#9DA3D6"
                       HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Limpia tus imágenes" FontSize="40" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Elimina metadatos y regenera los píxeles en un archivo nuevo"
                       FontSize="16" Foreground="#9DA3D6" HorizontalAlignment="Center" Margin="0,8,0,48"/>
            <Button x:Name="PickButton" Content="Sube tu imagen" Style="{StaticResource BigButton}"
                    HorizontalAlignment="Center" Click="PickButton_Click"/>
            <TextBlock Text="Puedes seleccionar varias a la vez o arrastrarlas a esta ventana"
                       FontSize="13" Foreground="#6E74A8" HorizontalAlignment="Center" Margin="0,28,0,0"/>
        </StackPanel>

        <!-- 2) PROCESANDO -->
        <StackPanel x:Name="WorkingPanel" Visibility="Collapsed" Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Limpiando imágenes…" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="CounterText" Text="0 / 0" FontSize="16" Foreground="#9DA3D6"
                       HorizontalAlignment="Center" Margin="0,10,0,28"/>
            <ProgressBar x:Name="Progress" Style="{StaticResource SlimProgress}" Minimum="0" Maximum="1" Value="0"/>
            <TextBlock x:Name="CurrentFileText" Text="" FontSize="13" Foreground="#6E74A8"
                       HorizontalAlignment="Center" Margin="0,18,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- 3) LISTO -->
        <StackPanel x:Name="DonePanel" Visibility="Collapsed" Width="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock Text="✓" FontSize="38" FontWeight="Bold" HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="DoneTitle" Text="¡Listo!" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="DoneSubtitle" Text="" FontSize="15" Foreground="#9DA3D6"
                       HorizontalAlignment="Center" Margin="0,8,0,20" TextWrapping="Wrap" TextAlignment="Center"/>

            <Border Background="#11142A" BorderBrush="#262A52" BorderThickness="1" CornerRadius="14"
                    MaxHeight="190" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ResultsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="#C9CDF5" FontSize="13"
                                           Margin="10,5" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock x:Name="SavedText" Visibility="Collapsed" Foreground="#6EE7B7" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                <Button x:Name="SaveButton" Content="Guardar imágenes…" Style="{StaticResource PrimaryButton}"
                        Click="SaveButton_Click"/>
                <Button x:Name="OpenFolderButton" Content="Abrir carpeta" Style="{StaticResource GhostButton}"
                        Visibility="Collapsed" Click="OpenFolderButton_Click"/>
                <Button x:Name="NewButton" Content="Limpiar más imágenes" Style="{StaticResource GhostButton}"
                        Click="NewButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
